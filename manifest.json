{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "default_locale": "ko",
  "description": "__MSG_extDescription__",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtubehelper.banshk.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-helper": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "__MSG_cmdToggleHelper__"
    },
    "zoom-in": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "__MSG_cmdZoomIn__"
    },
    "zoom-out": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "__MSG_cmdZoomOut__"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
